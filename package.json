{
  "name": "gantry-harness",
  "version": "0.1.0",
  "description": "Local-first interactive Host Harness and workspace manager for Gantry",
  "type": "module",
  "bin": {
    "gantry-harness": "./dist/cli.js"
  },
  "scripts": {
